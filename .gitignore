# Operating systems
.DS_Store
Thumbs.db
desktop.ini

# Editors and temporary files
*.swp
*.swo
*~
.vscode/
.idea/

# Stata temporary files
*.tmp
*.stswp

# Keep raw source downloads and generated reference outputs under version control
# once their provenance, checksums, and reproducibility have been verified.

# Local logs contain absolute machine paths; only publish scrubbed releases.
outputs/logs/*.log
outputs/logs/*.smcl

# Processed datasets are regenerated by the replication scripts.
# Release specific versions deliberately with git add -f after provenance review.
data/processed/*.dta
